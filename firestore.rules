rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Role-based authorization: Depends securely on Custom Claims (not client-controlled fields)
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny for unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection: Private to owner only, role restricted to parent/owner and immutable on update
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId 
        && (incoming().role == 'parent' || incoming().role == 'owner');
      allow update: if isSignedIn() && request.auth.uid == userId 
        && incoming().role == existing().role;
      allow delete: if isAdmin();
    }

    // Reviews Collection: Publicly readable for exploring nurseries, capped facility photos (<=5)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid
        && (!('facilityPhotos' in incoming()) || (incoming().facilityPhotos is list && incoming().facilityPhotos.size() <= 5));
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin())
        && (!('facilityPhotos' in incoming()) || (incoming().facilityPhotos is list && incoming().facilityPhotos.size() <= 5));
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Nursery Registration Requests Collection: Owner cannot self-approve
    match /nursery_requests/{requestId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && incoming().status == 'pending';
      allow update: if isAdmin() || (
        isSignedIn() &&
        existing().ownerId == request.auth.uid &&
        incoming().status == existing().status &&
        incoming().status != 'approved'
      );
      allow delete: if isAdmin();
    }

    // Tour Bookings Collection
    match /tour_bookings/{bookingId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Quick Contacts Collection
    match /quick_contacts/{contactId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Favorites Collection: Strictly validated fields and private to authenticated parent
    match /favorites/{favoriteId} {
      allow read, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().keys().hasAll(['userId', 'nurseryId'])
        && incoming().nurseryId is number;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
